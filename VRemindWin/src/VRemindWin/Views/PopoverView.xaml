<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="VRemindWin.Views.PopoverView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VRemindWin.Views.Controls"
    xmlns:models="using:VRemindWin.Core.Models">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BackgroundSizing="OuterBorderEdge"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="0"
        KeyDown="RootGrid_KeyDown">

        <Grid.Resources>
            <DataTemplate x:Key="ChannelRowTemplate" x:DataType="models:CliChannelItem">
                <Grid
                    Padding="10,7"
                    CornerRadius="6"
                    Background="Transparent"
                    ColumnSpacing="10"
                    ToolTipService.ToolTip="{x:Bind TooltipText}"
                    PointerEntered="ChannelRow_PointerEntered"
                    PointerExited="ChannelRow_PointerExited"
                    PointerPressed="ChannelRow_PointerPressed"
                    PointerMoved="ChannelRow_PointerMoved"
                    PointerReleased="ChannelRow_PointerReleased"
                    PointerCanceled="ChannelRow_PointerCanceled"
                    PointerCaptureLost="ChannelRow_PointerCaptureLost"
                    Tapped="ChannelRow_Tapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar with Initial Fallback + Live/Upcoming Ring + Platform Dot -->
                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                        <Border
                            Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{x:Bind EffectiveVisualKind, Converter={StaticResource StatusAvatarRingBrushConverter}}"
                            BorderThickness="2">
                            <Grid>
                                <TextBlock
                                    Text="{x:Bind InitialLetter}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Ellipse Width="32" Height="32">
                                    <Ellipse.Fill>
                                        <ImageBrush
                                            ImageSource="{x:Bind AvatarURL, Converter={StaticResource AvatarUriConverter}}"
                                            Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <Border
                            Width="10"
                            Height="10"
                            CornerRadius="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{x:Bind PlatformBadgeHex, Converter={StaticResource HexToBrushConverter}}"
                            BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderThickness="1.5" />
                    </Grid>

                    <!-- Channel Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                Text="{x:Bind Name}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="165"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="{x:Bind FormattedHandle}"
                                FontSize="11"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock
                            Text="{x:Bind StreamTitle}"
                            Visibility="{x:Bind HasStreamTitle, Converter={StaticResource BoolToVisibilityConverter}}"
                            FontSize="11.5"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock
                            Text="{x:Bind TimeLabel}"
                            FontSize="11"
                            FontWeight="Medium"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{x:Bind EffectiveVisualKind, Converter={StaticResource StatusTimeBrushConverter}}" />
                    </StackPanel>

                    <!-- Hover Delete & Live Pill Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border
                            Padding="5,1"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Background="{x:Bind EffectiveVisualKind, Converter={StaticResource StatusBadgeBrushConverter}}"
                            Visibility="{x:Bind ShowStatusBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                Text="{x:Bind StatusBadgeText}"
                                FontSize="9.5"
                                FontWeight="Bold"
                                Foreground="White" />
                        </Border>

                        <Button
                            x:Name="DeleteButton"
                            Width="28"
                            Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="Remove channel"
                            Tapped="DeleteButton_Tapped"
                            Click="DeleteChannel_Click">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="12" Foreground="#FFEF4444" />
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="VRemind"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

            <Border
                Grid.Column="1"
                Padding="7,2"
                CornerRadius="10"
                VerticalAlignment="Center"
                Background="{x:Bind ViewModel.LiveHeaderVisualKind, Mode=OneWay, Converter={StaticResource StatusBadgeBrushConverter}}"
                Visibility="{x:Bind ViewModel.HasLiveChannels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LiveCountBadgeText, Mode=OneWay}"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="White" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ProgressRing
                    Width="16"
                    Height="16"
                    Margin="0,0,4,0"
                    IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Refresh now"
                    IsEnabled="{x:Bind ViewModel.IsRefreshing, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                    Click="RefreshButton_Click">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="13" />
                </Button>

                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Settings"
                    Click="SettingsButton_Click">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="13" />
                </Button>

                <Button
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Quit VRemind"
                    Click="QuitButton_Click">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- Channel List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="6,6">
            <Grid>
                <!-- Empty State -->
                <StackPanel
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="6"
                    Padding="20,40"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xE7F4;"
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="No channels watched"
                        FontSize="13"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="Add a YouTube @handle or Twitch username below"
                        FontSize="11.5"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Grouped Sections -->
                <StackPanel
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">

                    <!-- LIVE NOW -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind ViewModel.HasLiveSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.LiveSectionHeader, Mode=OneWay}"
                            Margin="10,4,0,2"
                            FontSize="10.5"
                            FontWeight="Bold"
                            Foreground="{x:Bind ViewModel.LiveHeaderVisualKind, Mode=OneWay, Converter={StaticResource StatusTimeBrushConverter}}" />
                        <ItemsControl
                            x:Name="LiveItemsControl"
                            Tag="live"
                            ItemsSource="{x:Bind ViewModel.LiveChannels, Mode=OneWay}"
                            ItemTemplate="{StaticResource ChannelRowTemplate}" />
                    </StackPanel>

                    <!-- UPCOMING -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind ViewModel.HasUpcomingSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.UpcomingSectionHeader, Mode=OneWay}"
                            Margin="10,4,0,2"
                            FontSize="10.5"
                            FontWeight="Bold"
                            Foreground="{x:Bind ViewModel.IsUpcomingSectionCelebrating, Mode=OneWay, Converter={StaticResource CelebrationUpcomingHeaderBrushConverter}}" />
                        <ItemsControl
                            x:Name="UpcomingItemsControl"
                            Tag="upcoming"
                            ItemsSource="{x:Bind ViewModel.UpcomingChannels, Mode=OneWay}"
                            ItemTemplate="{StaticResource ChannelRowTemplate}" />
                    </StackPanel>

                    <!-- OFFLINE -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind ViewModel.HasOfflineSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.OfflineSectionHeader, Mode=OneWay}"
                            Margin="10,4,0,2"
                            FontSize="10.5"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ItemsControl
                            x:Name="OfflineItemsControl"
                            Tag="offline"
                            ItemsSource="{x:Bind ViewModel.OfflineChannels, Mode=OneWay}"
                            ItemTemplate="{StaticResource ChannelRowTemplate}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <!-- Bottom Add Bar -->
        <StackPanel
            x:Name="BottomAddBar"
            Grid.Row="4"
            Padding="12,10"
            Spacing="6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock
                Text="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasValidationError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                FontSize="11.5"
                TextWrapping="Wrap"
                Foreground="#FFEF4444" />

            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="PlatformComboBox"
                    Grid.Column="0"
                    MinWidth="96"
                    SelectedIndex="0"
                    SelectionChanged="PlatformComboBox_SelectionChanged">
                    <ComboBoxItem Tag="youtube">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#FFFF0000" />
                            <TextBlock Text="YouTube" FontSize="12" />
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem Tag="twitch">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#FF9146FF" />
                            <TextBlock Text="Twitch" FontSize="12" />
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <TextBox
                    x:Name="HandleTextBox"
                    Grid.Column="1"
                    FontSize="12.5"
                    PlaceholderText="{x:Bind ViewModel.InputPlaceholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.NewHandleInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    KeyDown="HandleTextBox_KeyDown" />

                <Button
                    Grid.Column="2"
                    Content="Add"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanAddChannel, Mode=OneWay}"
                    Click="AddButton_Click" />
            </Grid>
        </StackPanel>

        <!-- DirectX 10 Hardware-Accelerated Confetti Overlay -->
        <controls:ConfettiOverlayControl
            x:Name="ConfettiOverlay"
            Grid.RowSpan="5"
            IsHitTestVisible="False" />
    </Grid>
</UserControl>
