<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="VRemindWin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:VRemindWin.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <helpers:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" Invert="True" />
            <helpers:BoolNegationConverter x:Key="BoolNegationConverter" />
            <helpers:HexToSolidColorBrushConverter x:Key="HexToBrushConverter" />
            <helpers:StatusKindToTimeBrushConverter x:Key="StatusTimeBrushConverter" />
            <helpers:StatusKindToAvatarRingBrushConverter x:Key="StatusAvatarRingBrushConverter" />
            <helpers:StatusKindToBadgeBrushConverter x:Key="StatusBadgeBrushConverter" />
            <helpers:CelebrationBadgeBrushConverter x:Key="CelebrationBadgeBrushConverter" />
            <helpers:CelebrationLiveHeaderBrushConverter x:Key="CelebrationLiveHeaderBrushConverter" />
            <helpers:CelebrationUpcomingHeaderBrushConverter x:Key="CelebrationUpcomingHeaderBrushConverter" />
            <helpers:AvatarUriConverter x:Key="AvatarUriConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
